{
  "name": "interview-orange",
  "private": true,
  "version": "1.0.0",
  "description": "面试橙：AI 面试/笔试辅助桌面端，独立环境运行",
  "type": "module",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "start": "npm run build && node server/index.js",
    "serve": "node server/index.js",
    "build": "vite build --config web/vite.config.js",
    "dev": "vite --config web/vite.config.js",
    "seed": "node server/seed.js",
    "smoke": "node scripts/smoke.mjs",
    "native": "powershell -ExecutionPolicy Bypass -File native/run.ps1"
  },
  "dependencies": {
    "express": "^4.21.2",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^5.4.11"
  }
}
