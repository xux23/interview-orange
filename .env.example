# 端口 / 监听地址
ML_PORT=8756
ML_HOST=127.0.0.1

# 数据目录（相对项目根）
ML_DATA_DIR=data

# 令牌签名密钥（生产请改）
ML_SECRET=change-me-in-production-please

# AI provider：mock（离线，默认）| openai（任意 OpenAI 兼容网关）
# 注意：这几项只是「默认值」——设置页「AI 接入」写入 data/app.db 的覆盖优先于本文件，且热切换、无需重启；
#       「回退 .env」会删掉覆盖回到这里的值。优先级：设置页 > .env > 出厂默认。
ML_AI_PROVIDER=mock
ML_AI_BASE_URL=https://api.openai.com/v1
ML_AI_API_KEY=
ML_AI_MODEL=deepseek-v4.1-flash
# 笔试截图读题+解题（视觉）：qwen3.5-omni-flash 读题/解题延迟约为 3.8-omni 的 1/3，输出完整度相同
ML_AI_VISION_MODEL=qwen3.5-omni-flash
ML_AI_TEMPERATURE=0.6

# ASR 语音识别：留空 = 本地替身（stt.inject/stt.data 模拟）；填 key 即启用真实转写
# 选型实测（2026-11-24，maas.qianwenaiapi.com）：qwen3.5-omni-flash 中/英全对、~0.7s/句，为最快可用档
#   unisound/unisound-u2 未激活；专用 ASR（qwen-audio-3.0-asr-flash / fun-asr-flash）不支持 chat/completions 音频块；
#   qwen-audio-3.1-realtime-* 无 WS 入口，不可用
# 同样只是默认值：设置页「语音识别」的覆盖优先于本文件，热切换无需重启（回退 .env 即回到这里）
ML_ASR_BASE_URL=https://maas.qianwenaiapi.com/compatible-mode/v1
ML_ASR_API_KEY=
ML_ASR_MODEL=qwen3.5-omni-flash
# 静音收句门限（ms，200~6000）与单句最长时长（ms）
ML_ASR_SILENCE_GATE_MS=2000
ML_ASR_MAX_UTTERANCE_MS=30000
